---
import logo from '@assets/images/Logo.webp';
import { languages } from '@i18n/ui';
import { Image } from 'astro:assets';

const { data, lang } = Astro.props;
const newLang = lang === 'es' ? 'en' : 'es';
const sections = Object.keys(data);
---

<nav
  id='navbar'
  class='flex justify-between w-full z-10 transition duration-500 px-14 top-0 bg-transparent fixed text-white'
>
  <div class='h-24 aspect-video'>
    <Image src={logo} alt='Organic Chemical' class='h-full object-contain' />
  </div>
  <ul class='flex items-center gap-7 text-lg font-medium'>
    {
      sections.map((section: string) => (
        <li>
          <a href={'#' + section}>{data[section]}</a>
        </li>
      ))
    }
    <li>
      <button
        onclick=`window.location.replace('/${newLang}/')`
        title={languages[newLang].abbr}
        class='py-3 px-5 rounded-full text-white bg-primary cursor-pointer hover:bg-primary/80 transition'
      >
        {languages[newLang].abbr}
      </button>
    </li>
  </ul>
</nav>

<script>
  const navbar = document.getElementById('navbar');

  window.addEventListener('scroll', () => {
    if (!navbar) return;

    if (window.scrollY > 10) {
      navbar.classList.add('bg-gray-100', 'shadow-md');
      navbar.classList.remove('bg-transparent', 'text-white');
    } else {
      navbar.classList.add('bg-transparent', 'text-white');
      navbar.classList.remove('bg-gray-100', 'shadow-md');
    }
  });
</script>
