---
import { Image } from 'astro:assets';
import logo from '@assets/images/Logo.webp';

const { data } = Astro.props;
---

<footer class='flex max-md:flex-col gap-8 [&>*]:flex-1 px-section py-14 min-h-80 bg-gray-100'>
  <div class=''>
    <Image
      src={logo}
      alt='Organic Chemical'
      class='w-2/5 object-contain mr-auto'
    />
    <address class='font-medium not-italic mt-5 leading-loose'>
      Visítenos en: Calle 5B carrera 67 Manzana 11 Casa 2<br />
      Teléfono: (+57) 314 131 4351 <br />
      <a href='mailto:webmaster@example.com'>webmaster@example.com</a>
    </address>
  </div>
  <ul class='bg-blue-400'>
  </ul>
  <form class='flex flex-col gap-4'>
    <legend class='pb-2 text-2xl font-semibold border-b-2 border-b-gray-400'>
      {data.greeting}
    </legend>
    <label>
      {data.name}
      <input type="text" name="" placeholder={data.namePlaceholder}>
    </label>
    <label>
      {data.email}
      <input type="text" name="" placeholder={data.emailPlaceholder}>
    </label>
  </form>
</footer>

<style scoped>
  @reference "../../assets/styles/main.css";

  form label{
    display: flex;
    flex-direction: column;
    gap: .2rem;
    @apply text-lg
  }

  input {
    background-color: white;
    @apply rounded-lg px-3 py-1.5 text-base ring-secondary-600 focus-within:ring-1 focus:outline-0;
  }
</style>
