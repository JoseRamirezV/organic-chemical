---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';

import logo from '@assets/images/Logo.webp';
import LangSwitchButton from '@components/layout/LangSwitchButton.astro';

const { data, lang } = Astro.props;
const sections = Object.keys(data);
---

<button id='toggle-drawer' class='md:hidden text-2xl text-primary-700'>
  <Icon name='iconamoon:menu-burger-horizontal-bold' />
</button>
<div
  id='drawer'
  class='absolute top-0 left-full flex flex-col lg:hidden h-screen w-full text-white bg-white transition-[left]'
>
  <button id='close-drawer' class='text-2xl self-end p-4 pb-0 text-gray-700'>
    <Icon name='iconamoon:close-bold' />
  </button>
  <div>
    <header
      class='flex justify-between w-full z-10 ps-6 pe-10 border border-b-gray-200'
    >
      <a href={`/${lang}/`} class='aspect-video'>
        <Image src={logo} alt='Organic Chemical' class='w-24 object-contain' />
      </a>
      <LangSwitchButton lang={lang} />
    </header>
    <div
      class='flex flex-col items-start gap-4 py-4 px-8 text-gray-700 text-xl'
    >
      {
        sections.map((section: string) => (
          <li class='list-none'>
            <a
              onclick="document.getElementById('drawer').classList.replace('left-0', 'left-full');document.body.classList.toggle('overflow-clip')"
              href={'#' + data[section].link}
            >
              {data[section].label}
            </a>
          </li>
        ))
      }
    </div>
  </div>
</div>

<script>
  const toggleDrawerBtn = document.getElementById('toggle-drawer');
  const closeDrawerBtn = document.getElementById('close-drawer');
  const drawer = document.getElementById('drawer');

  toggleDrawerBtn?.addEventListener('click', toggleDrawer, true);

  closeDrawerBtn?.addEventListener('click', toggleDrawer, true);

  function toggleDrawer() {
    const isOpen = drawer?.classList.contains('left-0');
    document.body.classList.toggle('overflow-clip');

    if (isOpen) {
      drawer?.classList.replace('left-0', 'left-full');
    } else {
      drawer?.classList.replace('left-full', 'left-0');
    }
  }
</script>
