---
import type { Product } from '@interfaces/product.interface';
import LinkButton from '@components/common/LinkButton.astro';

interface Props {
	data: Product;
}
const { data } = Astro.props;
---

<article
	class='card-list-item relative md:h-80 lg:h-96 flex-1 group overflow-clip rounded-lg focus-within:flex-2 hover:flex-2 transition-[flex] duration-500'
>
	<figure class='h-full'>
		<img
			src={data.imgUrl}
			alt={data.name}
			class:list={[
				data.imgFit ? 'object-cover' : 'object-contain',
				'size-full max-sm:aspect-[3/4]',
			]}
			loading='lazy'
		/>
	</figure>

	<legend
		class='absolute bottom-0 left-full py-2 px-4 text-white lg:text-xl font-medium whitespace-pre rounded-tr-lg bg-secondary-600 -rotate-90 origin-bottom-left group-hover:-bottom-full transition-[bottom] duration-500'
	>
		{data.name}
	</legend>

	<div
		class='absolute flex flex-col size-full top-0 p-8 text-white bg-black/60 bg backdrop-blur-sm opacity-0 transition-opacity duration-500 group-focus-within:opacity-100 group-hover:opacity-100'
	>
		<h2
			class='sm:w-48 lg:w-2xs xl:w-[26rem] text-xl lg:text-3xl text-secondary-500 line-clamp-2 font-bold'
		>
			{data.name}
		</h2>

		<p
			class='my-4 w-full sm:w-48 lg:my-4 lg:w-2xs xl:w-[26rem] md:max-lg:line-clamp-5 line-clamp-6 max-sm:text-sm text-pretty'
		>
			{data.summary}
		</p>

		<footer class='max-sm:self-center mt-auto'>
			<LinkButton path={'products/' + data.id} class='rounded-full border-white lg:text-lg' />
		</footer>
	</div>
</article>
<style>
	@reference '../../assets/styles/main.css';
	
	h2, p, footer {
		@apply transition-[translate] duration-500 -translate-x-full group-hover:translate-0;
	}
</style>
