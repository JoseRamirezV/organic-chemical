---
import type { Product } from '@interfaces/product.interface';
import LinkButton from '@components/common/LinkButton.astro';

interface Props {
	data: Product;
}
const { data } = Astro.props;
---

<article
	class='card-list-item relative md:h-80 lg:h-96 flex-1 group overflow-clip rounded-lg focus-within:flex-2 hover:flex-2 transition-[flex] duration-500'
>
	<figure class='h-full'>
		<img
			src={data.imgUrl}
			alt={data.name}
			class:list={[
				data.imgFit ? 'object-cover' : 'object-contain',
				'size-full max-sm:aspect-[3/4]',
			]}
			loading='lazy'
		/>
	</figure>

	<legend
		class='absolute bottom-0 left-full py-2 px-4 text-white lg:text-xl font-medium whitespace-pre bg-secondary-600 -rotate-90 origin-bottom-left transition-[bottom] duration-500'
	>
		{data.name}
	</legend>

	<div
		class='absolute flex flex-col h-full w-full top-0 p-8 text-white bg-black/60 backdrop-blur-sm opacity-0 transition-opacity duration-500 group-focus-within:opacity-100 group-hover:opacity-100'
	>
		<h2
			class='lg:w-[26rem] text-xl lg:text-3xl text-secondary-500 line-clamp-2 font-bold'
		>
			{data.name}
		</h2>

		<p class='my-4 lg:my-4 w-full lg:w-[26rem] line-clamp-5 text text-pretty'>
			{data.summary}
		</p>

		<footer class='max-sm:mx-auto mt-auto'>
			<LinkButton path={'products/' + data.id} class='' />
		</footer>
	</div>
</article>
