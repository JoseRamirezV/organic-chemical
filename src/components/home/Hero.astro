---
import LinkButton from '@components/common/LinkButton.astro';
import { getLangFromUrl } from '@i18n/getLanguageFromUrl';
import { useTranslations } from '@i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title, subtitle, buttonText } = t('hero');
---

<div
	class='h-screen w-full flex items-center bg-[url(/images/fondo2.webp)] bg-cover'
>
	<article
		class='h-full w-full sm:h-full flex items-center max-sm:flex-col-reverse sm:gap-10 p-8 sm:px-14 bg-black/40'
	>
		<!-- <figure class="absolute inset-0 after:absolute after:inset-0 after:size-full overflow-clip">
			<img class="object-cover object-top w-full" src='/images/fondo2.webp'/>
		</figure> -->
		<div
			class='relative flex flex-col items-center max-sm:justify-center gap-24 flex-7/12 max-sm:text-center text-white'
		>
			<h2
				class='lg:w-4xl text-3xl sm:text-5xl lg:text-7xl capitalize font-bold text-center text-pretty lg:leading-24'
				set:html={title}
			>
			</h2>
			<span class="md:absolute md:-bottom-8/12">
				<LinkButton path='#' label={buttonText} hideIcon class='text-xl rounded-none outline-2 outline-white border-transparent'/>
			</span>
		</div>
		<!-- <picture class='hidden h-full w-full flex-2/5 flex justify-center items-center sm:p-10'> -->
		<!-- <source
      srcset='/img/ejemplo@2x.webp'
      type='image/webp'
      media='(min-width: 768px)'
    /> -->
		<!-- <img
          src='/images/slide1.webp'
          class='w-full sm:w-96 aspect-[6/4] sm:aspect-square rounded-full object-cover'
          alt='Imagen alusiva: persona usando la app en un teléfono'
          loading='lazy' -->
		<!-- /> -->
		<!-- Si la imagen solo decora, omite figcaption y deja alt="" -->
		<!-- <figcaption>Opcional: leyenda si añade información relevante.</figcaption> -->
		<!-- </picture> -->
	</article>
</div>
