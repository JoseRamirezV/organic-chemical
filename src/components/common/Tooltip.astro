---
const { text } = Astro.props;
---

<span class='tooltip tooltip-arrow'>{text}</span>

<style>
  @reference '../../assets/styles/main.css';

  .tooltip {
    @apply absolute flex justify-center -top-1/2 right-full bg-gray-700 text-white py-1 px-3 mr-1 rounded-lg rounded-br-none scale-0 opacity-0 transition-[opacity,scale] origin-bottom-right group-hover:opacity-100 group-hover:scale-100;
  }

