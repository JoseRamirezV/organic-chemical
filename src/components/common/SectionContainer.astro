---
interface Props {
	class?: string;
	id: string;
}

const { class: className, id } = Astro.props;
---

<section
	id={id}
	data-section={id}
	class={`${className ?? ''} w-full scroll-mt-20 sm:scroll-mt-24`}
>
	<slot />
</section>

