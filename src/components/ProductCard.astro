---
import type { Product } from '@interfaces/product';
import LinkButton from './LinkButton.astro';

interface Props {
  data: Product;
}
const { data } = Astro.props;
---

<article class='relative h-full flex-1 group overflow-clip hover:flex-2 transition-[flex]'>
  <figure
    class='h-full'
  >
    <img
      src={data.imgUrl}
      alt='Portátil sobre un escritorio con libreta y taza'
      class='size-full object-cover'
      loading='lazy'
    />
  </figure>

  <legend class="absolute bottom-0 left-full py-2 px-4 text-white text-xl font-medium whitespace-pre bg-primary -rotate-90 origin-bottom-left transition-[bottom] duration-300 group-hover:-bottom-full">
    {data.name}
  </legend>

  <div
    class='absolute flex flex-col h-full top-0 p-5 text-white bg-black/40 backdrop-blur-sm opacity-0 transition-opacity duration-300 group-hover:opacity-100'
  >
    <header class='text-xl'>
      <h2>{data.name}</h2>
    </header>

    <p class='my-4'>
      {data.description}
    </p>

    <footer class='mt-auto'>
      <LinkButton path='' />
    </footer>
  </div>
</article>
