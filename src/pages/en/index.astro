---
import Main from '@components/Main.astro';
import Layout from '@layouts/Layout.astro';

import us from '@data/en/company.json';
import slides from '@data/en/heroSlides.json';
import products from '@data/en/products.json';

const data = {
	us,
	slides,
	products,
};
---

<Layout
	title='Organic & Chemical Group'
	description='Organic & Chemical Group is a company dedicated to promoting the use of organic products for agriculture. Finding efficient solutions that restore and improve soil efficiency and fertility..'
>
	<Main data={data}/>
</Layout>
