---
import { getLangFromUrl, useTranslations } from '@i18n/utils';

import SectionContainer from '@components/SectionContainer.astro';
import Layout from '@layouts/Layout.astro';
import Hero from '@sections/Hero.astro';
import Products from '@sections/Products.astro';
import Us from '@sections/Us.astro';

import products from '@data/es/products.json';
import slides from '@data/es/heroSlides.json'
import us from '@data/es/company.json'

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout
  title='Organic & Chemical group'
  description='Organic & Chemical Group es una compañía dedicada a promover el uso de productos de carácter orgánicos para el agro. Encontrando soluciones eficientes que recuperen y mejoren la eficiencia y fertilidad de los suelos'
>
  <SectionContainer id='home'>
    <Hero data={slides}/>
  </SectionContainer>
  <SectionContainer id='products'>
      <Products data={products}/>
  </SectionContainer>
  <SectionContainer id='about-me'>
    <Us data={us}/>
  </SectionContainer>
</Layout>
