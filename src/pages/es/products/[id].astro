---
import Prose from '@components/products/Prose.astro';
import products from '@data/es/products.json';
import type { Product } from '@interfaces/product.interface';
import Layout from '@layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import { getEntry, render } from 'astro:content';

interface Props {
	product: Product;
}

const { product } = Astro.props as Props;
const { id, name, summary, imgUrl, imgFit } = product;
const entry = await getEntry('descriptions', `es/${id}`);

if (!entry) {
	return Astro.redirect('/404');
}

const { Content } = await render(entry);

export async function getStaticPaths() {
	return products.map((p) => ({
		params: { id: p.id },
		props: { product: p },
	}));
}
---

<Layout title={name} description={summary}>
	<section class='flex flex-col gap-3 md:gap-5 mt-20 mb-5 md:my-28 px-5'>
		<a
			href={'/es/products'}
			class='flex items-center gap-1 w-fit transition-[color,gap] hover:gap-2 hover:text-primary-700'
		>
			<Icon name='iconamoon:arrow-left-1-bold' class='size-4' />
			Todos los productos
		</a>
		<figure class='flex max-md:flex-col-reverse justify-between gap-10 my-4'>
			<img
				src={imgUrl}
				alt={name}
				class:list={[
					imgFit ? 'object-cover' : 'object-contain',
					'w-full md:w-1/3 aspect-square rounded-xl',
				]}
			/>
			<figcaption class='flex-2'>
				<Prose>
					<Content />
				</Prose>
			</figcaption>
		</figure>
		<div></div>
	</section>
</Layout>
